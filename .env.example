# Azure resource configuration — fill in or set as real environment variables.
# NEVER commit real secrets. Prefer Managed Identity / az login (DefaultAzureCredential)
# in production; the API keys below are only a local-dev fallback.

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=product-catalog
AZURE_SEARCH_API_KEY=

# --- Azure Blob Storage (product images) ---
AZURE_STORAGE_ACCOUNT_URL=https://<your-storage-account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=product-images
AZURE_STORAGE_CONNECTION_STRING=

# --- Azure AI Vision (multimodal embeddings for image + text vectors) ---
# Image Retrieval "Vectorize Image/Text" API (Florence-based multimodal embeddings)
AZURE_AI_VISION_ENDPOINT=https://<your-vision-resource>.cognitiveservices.azure.com
AZURE_AI_VISION_API_KEY=
AZURE_AI_VISION_API_VERSION=2024-02-01

# Embedding dimensionality produced by the multimodal embedding model (1024 for Florence)
EMBEDDING_DIMENSIONS=1024
